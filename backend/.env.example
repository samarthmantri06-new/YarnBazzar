DATABASE_URL="postgresql://user:pass@host/dbname"
JWT_SECRET="your_jwt_secret_here"
PORT=5000


# ─── Email (REQUIRED on Render — SMTP is blocked on free tier) ───────────────
# Use Brevo HTTP API (recommended): https://www.brevo.com — free 300 emails/day
# 1. Create account → Settings → SMTP & API → generate API key
# 2. Senders → Add a sender → verify your Gmail address
# 3. Add BREVO_API_KEY + EMAIL_USER to Render environment variables
BREVO_API_KEY="your_brevo_api_key"
EMAIL_USER="your-verified-sender@gmail.com"

# Alternative: Resend HTTP API — https://resend.com
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="onboarding@resend.dev"

# Local dev only (Gmail SMTP — does NOT work on Render free tier)
# EMAIL_PASS="xxxx xxxx xxxx xxxx"
